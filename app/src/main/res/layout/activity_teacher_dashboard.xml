<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTeacher"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary"
        app:title="Teacher Portal"
        app:titleTextColor="@color/white" />

    <FrameLayout
        android:id="@+id/teacherContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarTeacher"
        android:layout_above="@id/bottomNavTeacher" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavTeacher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/surface"
        app:menu="@menu/menu_teacher_bottom_nav"
        app:itemIconTint="@color/primary"
        app:itemTextColor="@color/primary" />
</RelativeLayout>
