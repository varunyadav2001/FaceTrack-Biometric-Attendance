<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base Deep Charcoal Black -->
    <item>
        <color android:color="#0B0F19" />
    </item>

    <!-- Subtle Soft Rose Ambient Radial Glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#180A12"
                android:endColor="#070A10"
                android:startColor="#1E0B16"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
