<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Off-White Base -->
    <item>
        <color android:color="#F8F9FC" />
    </item>

    <!-- Ambient Light Pastel Gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:centerColor="#FAFAFE"
                android:endColor="#F5F3FF"
                android:startColor="#FFF1F2"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
